if(NOT EXISTS "${PLAYER_DIRECTORY}/PrappyPlayer.exe")
  message(FATAL_ERROR "Build the native player before checking its package")
endif()
foreach(required IN ITEMS PrappyPlayer.pdb PrappyReports.exe PrappyReports.pdb sentry-crash.exe sentry-wer.dll licenses/sentry-native.txt licenses/boost.txt licenses/sentry-jsmn.txt licenses/sentry-mpack.txt licenses/sentry-stb_sprintf.txt)
  if(NOT EXISTS "${PLAYER_DIRECTORY}/${required}")
    message(FATAL_ERROR "Missing reporting package component: ${required}")
  endif()
endforeach()
if(EXISTS "${PLAYER_DIRECTORY}/libmpv-2.dll")
  message(FATAL_ERROR "The player directory still ships the independent MPV test oracle")
endif()
file(STRINGS "${PLAYER_DIRECTORY}/PrappyPlayer.exe" regression_dispatch
  REGEX "--(sampling|state|meter)-test" ENCODING UTF-16LE)
if(regression_dispatch)
  message(FATAL_ERROR "The player still embeds explicit regression dispatch: ${regression_dispatch}")
endif()
