# Dependencies are materialized once by scripts/reporting-deps.ps1, at pinned hashes.
set(reporting_deps "${CMAKE_CURRENT_SOURCE_DIR}/build/reporting-deps")
set(boost_root "${reporting_deps}/boost_1_91_0")
if(NOT EXISTS "${boost_root}/boost/stacktrace.hpp" OR NOT EXISTS "${reporting_deps}/sentry-native/CMakeLists.txt")
  message(FATAL_ERROR "Missing reporting dependencies. Run scripts/reporting-deps.ps1.")
endif()
set(SENTRY_BACKEND native CACHE STRING "" FORCE)
set(SENTRY_TRANSPORT winhttp CACHE STRING "" FORCE)
set(SENTRY_BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(SENTRY_BUILD_RUNTIMESTATIC ON CACHE BOOL "" FORCE)
set(SENTRY_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(SENTRY_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(SENTRY_TRANSPORT_COMPRESSION OFF CACHE BOOL "" FORCE)
add_subdirectory("${reporting_deps}/sentry-native" "${CMAKE_CURRENT_BINARY_DIR}/reporting-sdk" EXCLUDE_FROM_ALL)
add_library(prappy_exception_trace STATIC "${boost_root}/libs/stacktrace/src/from_exception.cpp" "${boost_root}/libs/stacktrace/src/windbg.cpp")
target_include_directories(prappy_exception_trace SYSTEM PUBLIC "${boost_root}")
target_compile_definitions(prappy_exception_trace PUBLIC BOOST_STACKTRACE_NO_LIB BOOST_STACKTRACE_USE_WINDBG BOOST_STACKTRACE_LINK BOOST_STACKTRACE_STATIC_LINK PRIVATE BOOST_STACKTRACE_SOURCE)
set_source_files_properties("${boost_root}/libs/stacktrace/src/windbg.cpp" PROPERTIES COMPILE_OPTIONS /wd4005)
add_library(prappy_reporting STATIC src/crash_reporting.cpp)
target_include_directories(prappy_reporting PUBLIC src)
target_include_directories(prappy_reporting SYSTEM PRIVATE third_party/json)
target_compile_definitions(prappy_reporting PUBLIC UNICODE _UNICODE NOMINMAX WIN32_LEAN_AND_MEAN)
target_compile_options(prappy_reporting PRIVATE /W4 /WX /utf-8 /EHsc /Zi /external:W0)
target_link_libraries(prappy_reporting PUBLIC sentry::sentry prappy_exception_trace dbghelp dbgeng ole32)
add_executable(prappy_report_collector src/report_collector.cpp)
set_target_properties(prappy_report_collector PROPERTIES OUTPUT_NAME PrappyReports)
target_include_directories(prappy_report_collector SYSTEM PRIVATE third_party/json)
target_compile_definitions(prappy_report_collector PRIVATE UNICODE _UNICODE NOMINMAX WIN32_LEAN_AND_MEAN)
target_compile_options(prappy_report_collector PRIVATE /W4 /WX /utf-8 /EHsc /Zi)
target_link_libraries(prappy_report_collector PRIVATE ws2_32 dbgeng dbghelp ole32)
target_link_options(prappy_report_collector PRIVATE /DEBUG /INCREMENTAL:NO)
add_executable(prappy_crash_probe tests/crash_probe.cpp)
target_link_libraries(prappy_crash_probe PRIVATE prappy_reporting)
target_compile_options(prappy_crash_probe PRIVATE /Zi /Od /EHsc)
target_link_options(prappy_crash_probe PRIVATE /DEBUG /INCREMENTAL:NO)
set_target_properties(prappy_crash_probe PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/tests")
add_dependencies(prappy_reporting prappy_report_collector)
add_dependencies(prappy_report_collector sentry-crash sentry-wer)
foreach(report_binary IN ITEMS sentry-crash sentry-wer)
  add_custom_command(TARGET prappy_report_collector POST_BUILD
    COMMAND ${CMAKE_COMMAND} -E copy_if_different "$<TARGET_FILE:${report_binary}>" "${CMAKE_CURRENT_BINARY_DIR}/")
endforeach()
add_custom_command(TARGET prappy_report_collector POST_BUILD
  COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_CURRENT_BINARY_DIR}/licenses"
  COMMAND ${CMAKE_COMMAND} -E copy_if_different "${reporting_deps}/sentry-native/LICENSE" "${CMAKE_CURRENT_BINARY_DIR}/licenses/sentry-native.txt"
  COMMAND ${CMAKE_COMMAND} -E copy_if_different "${boost_root}/LICENSE_1_0.txt" "${CMAKE_CURRENT_BINARY_DIR}/licenses/boost.txt")
foreach(notice IN ITEMS jsmn mpack stb_sprintf)
  add_custom_command(TARGET prappy_report_collector POST_BUILD
    COMMAND ${CMAKE_COMMAND} -E copy_if_different "${reporting_deps}/sentry-native/vendor/${notice}.h" "${CMAKE_CURRENT_BINARY_DIR}/licenses/sentry-${notice}.txt")
endforeach()
